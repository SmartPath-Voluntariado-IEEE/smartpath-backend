SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave administrativa: requerida por los endpoints de catálogo e ingesta.
# Basta con una de las dos (sb_secret_... o la legacy service_role).
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIRECT_URI=
APIFY_API_TOKEN=
APIFY_ACTOR_ID=crawlerbros~class-central-scraper
# ------------------------------------------------
# HU-57: recolección de ofertas laborales (JobSpy)
# ------------------------------------------------
# Todas son opcionales; los valores mostrados son los que se usan por
# defecto. JobSpy no necesita clave de API. Ver docs/job_sources.md.
#
# LinkedIn se deja fuera por defecto: limita por IP muy rápido y una corrida
# bloqueada deja el lote entero vacío. Actívalo solo con proxies.
JOBSPY_SITES=indeed
JOBSPY_COUNTRY=peru
JOBSPY_LOCATION=Peru
JOBSPY_RESULTS_PER_TERM=25
JOBSPY_HOURS_OLD=720
JOBSPY_DELAY_SECONDS=3
JOBSPY_PROXIES=
